# Copy this file to .env.local and fill in the values from your Supabase
# project's dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — required for public sign-up (/signup creates accounts via
# the Supabase Auth admin API, already confirmed, so it's usable
# immediately regardless of the project's "Confirm email" setting).
# NEVER prefix this with NEXT_PUBLIC_ and never import it from client code
# — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — your production domain, used for the sitemap/robots.txt
# (src/app/sitemap.ts, src/app/robots.ts). Falls back to the Vercel URL
# if unset; set this once you're on a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
