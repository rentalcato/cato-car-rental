# Copy this file to .env.local and fill in the values from your Supabase
# project's dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used for future admin scripts/seeding. NEVER prefix this
# with NEXT_PUBLIC_ and never import it from client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
